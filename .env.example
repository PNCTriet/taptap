# ==============================================================================
# TAPTAP — Environment Configuration Template (Phase 0)
# Copy this file to `.env.local` for local development.
# NEVER commit `.env` or `.env.local` files containing real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Application URL
# Used to construct canonical NFC/QR station links: <NEXT_PUBLIC_APP_URL>/s/<code >
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Public Client Configuration (Safe for Browser & Server SSR)
# Note on Supabase API Keys:
# - Legacy convention: `NEXT_PUBLIC_SUPABASE_ANON_KEY` (JWT starting with `eyJ...`)
# - Modern convention: Supabase Publishable Key (`sb_publishable_...`)
# Both work with `@supabase/supabase-js` and `@supabase/ssr`. Store either your
# project's Publishable Key or Anon Key in `NEXT_PUBLIC_SUPABASE_ANON_KEY`.
# All client queries are strictly governed by PostgreSQL Row Level Security (RLS).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_with_your_anon_or_publishable_key

# ------------------------------------------------------------------------------
# 3. Supabase Privileged Server-Only Key (NEVER prefix with NEXT_PUBLIC_)
# Used exclusively by `src/lib/supabase/admin.ts` (protected by `server-only`).
# Required for privileged server-side workflows that bypass RLS after strict
# domain validation. Accepts legacy `service_role` JWT or `sb_secret_...` key.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_with_your_service_role_key
